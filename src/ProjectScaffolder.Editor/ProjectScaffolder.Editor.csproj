<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ProjectScaffolder.Core\ProjectScaffolder.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ProjectScaffolder.Editor</AssemblyName>
    <Version>2.0.0-alpha.7</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\ProjectScaffolder.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\examples\demo-template.json" Link="SeedTemplates\demo-template.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\ProjectScaffolder.ico" />
    <None Update="Assets\Scaffolder.svg" />
    <None Update="Assets\file-box.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
