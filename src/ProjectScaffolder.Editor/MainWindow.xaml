<Window x:Class="ProjectScaffolder.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProjectScaffolder.Editor.ViewModels"
        mc:Ignorable="d"
        Title="Project Scaffolder" Icon="Assets/ProjectScaffolder.ico" Width="1380" Height="790" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:EditorNodeViewModel}" ItemsSource="{Binding Children}">
            <Border Tag="NodeLabel" Padding="3,1" CornerRadius="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="23" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Width="23" Text="{Binding Icon}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Grid.Column="1" MinWidth="150" Padding="3,1" Text="{Binding Name, Mode=OneWay}"
                             IsVisibleChanged="InlineName_IsVisibleChanged" LostKeyboardFocus="InlineName_LostKeyboardFocus"
                             PreviewKeyDown="InlineName_PreviewKeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="49" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding NewTemplateCommand}" Content="New" />
                    <Button IsEnabled="False" Content="Import folder" ToolTip="Folder import is the next editor slice." />
                    <Button Command="{Binding DuplicateTemplateCommand}" Content="Duplicate" />
                    <Button Click="RemoveTemplate_Click" Content="Remove" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Theme" />
                    <ComboBox x:Name="ThemePicker" Width="105" SelectedIndex="0" SelectionChanged="ThemePicker_SelectionChanged">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" MinWidth="210" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="310" MinWidth="270" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PaneBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="178" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Margin="12,0" FontWeight="SemiBold" Text="Templates" />
                    </Border>
                    <ListBox Grid.Row="1" Margin="7" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedListItem}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ItemSummary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsEnabled="{Binding CanToggleExplorer}"
                                              IsChecked="{Binding IsExplorerEnabled, Mode=TwoWay}"
                                              ToolTip="Show this template in the Explorer menu (registration is implemented in Milestone 4)." />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" Padding="11" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel DataContext="{Binding SelectedTemplate}">
                            <TextBlock Margin="0,0,0,5" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Template name" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,9,0,7" Foreground="{DynamicResource WarningBrush}" Text="{Binding DirtyStatus}" />
                            <Button Margin="0" Command="{Binding DataContext.SaveTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="Save template" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
            <Border Grid.Column="2" Background="{DynamicResource PaneBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <TextBlock FontWeight="SemiBold" Text="Project structure" />
                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Folders and files" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="10,7" Orientation="Horizontal">
                        <Button Command="{Binding AddFolderCommand}" Content="Folder" />
                        <Button Command="{Binding AddTextFileCommand}" Content="Add text file" />
                        <Button Click="AttachFile_Click" IsEnabled="{Binding HasSelectedTemplate}" Content="Attach file…" />
                        <Button Command="{Binding RenameNodeCommand}" Content="Rename" ToolTip="Rename the selected item (F2)." />
                        <Button Command="{Binding DeleteNodeCommand}" Content="Delete item" />
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="10,0,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="ProjectRootBorder" Padding="11,0" BorderThickness="0,0,0,1" AllowDrop="True"
                                BorderBrush="{DynamicResource BorderBrush}"
                                MouseLeftButtonDown="ProjectRoot_MouseLeftButtonDown"
                                DragOver="ProjectRoot_DragOver" DragLeave="DropSurface_DragLeave" Drop="ProjectRoot_Drop"
                                ToolTip="Select the project root to add first-level folders and files.">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProjectRootSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Width="23" Text="□" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{}{{project_name}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Text="project root" />
                            </Grid>
                        </Border>
                        <TreeView x:Name="StructureTree" Grid.Row="1" Padding="9" ItemsSource="{Binding SelectedTemplate.Nodes}" AllowDrop="True"
                                  PreviewMouseLeftButtonDown="StructureTree_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="StructureTree_PreviewMouseLeftButtonUp"
                                  PreviewMouseMove="StructureTree_PreviewMouseMove" DragOver="StructureTree_DragOver"
                                  DragLeave="DropSurface_DragLeave" Drop="StructureTree_Drop"
                                  SelectedItemChanged="StructureTree_SelectedItemChanged" />
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
            <Border Grid.Column="4" Background="{DynamicResource PaneBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <TextBlock FontWeight="SemiBold" Text="Selected item" />
                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SelectedNode.TypeLabel}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" Padding="12" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedNode}">
                            <StackPanel Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,0,0,5" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="If the file exists" />
                                <ComboBox DisplayMemberPath="Label"
                                          ItemsSource="{Binding DataContext.FileCollisionChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding Collision}"
                                          SelectedValuePath="Value" />
                                <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Text="Choose Use template default to inherit the template setting." />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsTextFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,13,0,5" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Encoding" />
                                <ComboBox DisplayMemberPath="Label"
                                          ItemsSource="{Binding DataContext.TextEncodingChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding Encoding}"
                                          SelectedValuePath="Value" />
                                <TextBlock Margin="0,13,0,5" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Line endings" />
                                <ComboBox DisplayMemberPath="Label"
                                          ItemsSource="{Binding DataContext.LineEndingChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding LineEndings}"
                                          SelectedValuePath="Value" />
                                <TextBlock Margin="0,13,0,5" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Text content" />
                                <TextBox MinHeight="260" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Margin="0,7,0,0" IsEnabled="False" Content="⌘  Insert variable" ToolTip="Variable insertion menu is coming in the next editor slice." />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsAssetFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,13,0,5" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Managed package file" />
                                <TextBox IsReadOnly="True" Text="{Binding AssetFileName, Mode=OneWay}" />
                                <TextBlock Margin="0,13,0,5" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Integrity" />
                                <TextBox IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" Text="{Binding AssetDigestDisplay, Mode=OneWay}" />
                                <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Attached files are copied verbatim. Project variables are not substituted in their contents." TextWrapping="Wrap" />
                                <Button Margin="0,13,0,0" Click="ReplaceAttachedFile_Click" Content="Replace attached contents…" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0" Foreground="{DynamicResource SuccessBrush}" Text="●" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding SelectedTemplate.ValidationStatus}" />
                    <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SelectedTemplate.ItemSummary}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,12,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding StatusMessage}" />
                    <Button Margin="0" IsEnabled="False" Content="Test template..." ToolTip="Resolved preview is coming in the next editor slice." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
