<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#171717" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#595959" />
    <SolidColorBrush x:Key="AccentBrush" Color="#286FBA" />
    <SolidColorBrush x:Key="AccentSelectionBrush" Color="#CDE3FA" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
</ResourceDictionary>
