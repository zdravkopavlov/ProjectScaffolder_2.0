<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#242424" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#292929" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#303030" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="BorderBrush" Color="#474747" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#79AEEE" />
    <SolidColorBrush x:Key="AccentSelectionBrush" Color="#35577D" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#70D993" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2C94C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7777" />
</ResourceDictionary>
