{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Scaffolder Project Identity v1",
  "description": "Contract for the engine-owned .projectID.json file in a scaffolded project root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "createdAtUtc",
    "projectName",
    "template",
    "generator"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "$ref": "#/$defs/uuidV7"
    },
    "createdAtUtc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuidV7"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "Project Scaffolder"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
