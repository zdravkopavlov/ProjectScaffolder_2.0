{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Scaffolder Template Library v1",
  "description": "Per-user template ordering and Explorer enablement state. This state is not exported with templates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateOrder",
    "explorerTemplateIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "templateOrder": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuidV7"
      }
    },
    "explorerTemplateIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuidV7"
      }
    }
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
